<%- include('partials/header') %>

<h1><%= title %></h1>

<!-- Add Category Link -->
<p>
    
    <% if (user && user.role_name === 'admin') { %>
        <a href="/new-category">Add Category</a>
    <% } %>
  </p>

<h2>Project Categories</h2>

<ul>
    <% categories.forEach(category => { %>
        <li>
            <a href="/category/<%= category.category_id %>">
                <%= category.name %>
            </a>
    <% }) %>
</ul>

<%- include('partials/footer') %>