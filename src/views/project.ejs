<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>
    <p><strong>Description:</strong> <%= project.description %></p>
    <p><strong>Date:</strong> <%= new Date(project.start_date).toDateString() %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p>
        <strong>Partner Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>
    <!-- Add Edit Categories link here -->
    <p>
        <% if (user && user.role_name === 'admin') { %>
            <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
        <% } %>
        
    </p>

    <!-- Add Edit Project link here -->
    <p>
        <% if (user && user.role_name === 'admin') { %>
            <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
        <% } %>
        
    </p>

    <!-- Volunteer -->
    <p>
        <% if (user) { %>
            <% if (isVolunteer) { %>
                <p>You are volunteering for this project.</p>
                <a href="/project/<%= project.project_id %>/unvolunteer">Remove me</a>
            <% } else { %>
                <a href="/project/<%= project.project_id %>/volunteer">Volunteer</a>
            <% } %>
        <% } %>
    </p>

    <p><a href="/projects">Back to Upcoming Projects</a></p>
</main>

<%- include('partials/footer') %>